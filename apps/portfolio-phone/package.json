{
	"name": "portfolio-phone",
	"private": true,
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"dev": "vite dev --port 3002 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 3002",
		"typecheck": "tsc --noEmit",
		"preview:cf": "DEPLOY_TARGET=cloudflare vite build && DEPLOY_TARGET=cloudflare vite preview",
		"deploy": "DEPLOY_TARGET=cloudflare vite build && wrangler deploy"
	},
	"dependencies": {
		"@hookform/resolvers": "^7.0.7",
		"@repo/content": "workspace:*",
		"@repo/ui": "workspace:*",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-query": "^5.108.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
		"lucide-react": "^1.75.0",
		"motion": "^14.14.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.92.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.3.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.67.0",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"typescript": "^6.0.2",
		"vite": "^8.3.8",
		"wrangler": "^4.158.0"
	}
}
