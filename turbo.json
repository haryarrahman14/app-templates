{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**"]
		},
		"dev": { "cache": false, "persistent": true },
		"typecheck": { "dependsOn": ["^typecheck"] },
		"test": { "dependsOn": ["^test"] }
	}
}
