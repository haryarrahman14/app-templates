{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**", "!**/routeTree.gen.ts", "!**/*.css", "!design", "!**/*.md"] },
	"formatter": { "enabled": true, "indentStyle": "tab", "lineWidth": 100 },
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } },
	"javascript": { "formatter": { "quoteStyle": "double" } },
	"overrides": [
		{
			"includes": ["packages/ui/src/components/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useFocusableInteractive": "off",
						"useKeyWithClickEvents": "off",
						"useSemanticElements": "off"
					},
					"correctness": { "noComponentHookFactories": "off", "useExhaustiveDependencies": "off" },
					"security": { "noDangerouslySetInnerHtml": "off" },
					"suspicious": { "noArrayIndexKey": "off", "noDocumentCookie": "off" }
				}
			}
		}
	]
}
