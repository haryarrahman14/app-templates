{
	"name": "@repo/ui",
	"private": true,
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"imports": {
		"#components/*": "./src/components/*.tsx",
		"#lib/*": "./src/lib/*.ts",
		"#hooks/*": "./src/hooks/*.ts"
	},
	"exports": {
		"./components/*": "./src/components/*.tsx",
		"./lib/*": "./src/lib/*.ts",
		"./hooks/*": "./src/hooks/*.ts",
		"./styles/*": "./src/styles/*"
	},
	"scripts": {
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "^1.75.0",
		"radix-ui": "^1.8.1",
		"react-day-picker": "^10.0.2",
		"react-hook-form": "^7.92.0",
		"recharts": "3.8.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.2"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19"
	}
}
